{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "bun --env-file=../../apps/web/.env.local --bun prisma migrate dev",
    "db:deploy": "bun --env-file=../../apps/web/.env.local --bun prisma migrate deploy",
    "db:studio": "bun --env-file=../../apps/web/.env.local --bun prisma studio"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "@types/node": "26.4.1",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "^8.23.1"
  }
}
