// Prisma schema: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  invoices  Invoice[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
// "Overdue" is not stored: it is SENT with a due date in the past.
enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

model Invoice {
  id                  String        @id @default(cuid())
  status              InvoiceStatus @default(DRAFT)
  clientName          String?
  clientEmail         String
  currency            String
  /// LineItem[] from @repo/shared
  items               Json
  total               Decimal       @db.Decimal(12, 2)
  dueDate             DateTime      @db.Date
  note                String?
  /// The original chat/email the invoice was extracted from
  sourceText          String?
  paypalInvoiceId     String?       @unique
  paypalInvoiceNumber String?
  payLink             String?
  paidAt              DateTime?
  reminderCount       Int           @default(0)
  lastReminderAt      DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  
  userId             String
  user               User          @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([createdAt])
}
